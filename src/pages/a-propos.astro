---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FinalCta from '@/components/FinalCta.astro';
import consultant from '@/assets/images/consultant-office.jpg';
import family from '@/assets/images/family-reunion.jpg';
import { contact, stats } from '@/data/site';

const values = [
  {
    icon: 'lucide:handshake',
    title: 'Proximité',
    text: 'Proxima, comme proximité. Un bureau à Deido, un conseiller qui connaît votre dossier et qui répond sur WhatsApp.',
  },
  {
    icon: 'lucide:scale',
    title: 'Honnêteté',
    text: 'Si un programme ne vous correspond pas, on vous le dit dès l’évaluation. Et personne ne peut garantir un visa : nous non plus.',
  },
  {
    icon: 'lucide:search-check',
    title: 'Rigueur',
    text: 'Chaque pièce est vérifiée, chaque formulaire relu. Un dossier refusé pour un oubli, c’est des mois perdus.',
  },
  {
    icon: 'lucide:receipt-text',
    title: 'Transparence',
    text: 'Devis gratuit, prix fixés dans le contrat, aucun frais caché découvert en cours de route.',
  },
];
---

<BaseLayout
  title="À propos du cabinet"
  description="Proxima SARL, cabinet de conseil en immigration Canada basé à Douala (Deido). 5 ans d’expertise, plus de 100 dossiers acceptés."
>
  <PageHero
    eyebrow="À propos de Proxima"
    title="Un cabinet camerounais, <span class='text-blue'>tourné vers le Canada.</span>"
    lead="Depuis 5 ans, Proxima SARL accompagne des étudiants, des professionnels et des familles de Douala et de tout le Cameroun jusqu’à leur visa canadien."
    image={consultant}
    imageAlt="Une conseillère explique un dossier à un jeune client attentif"
  />

  <section class="pb-6" aria-label="Proxima en chiffres">
    <div class="container-page">
      <dl class="grid grid-cols-2 gap-y-8 border-t border-line pt-10 lg:grid-cols-4">
        {
          stats.map((s, i) => (
            <div class="px-2 lg:border-l lg:border-line lg:px-8 lg:first:border-l-0 lg:first:pl-0" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <dt class="sr-only">{s.label}</dt>
              <dd>
                <span class="display block text-4xl text-blue sm:text-5xl">{s.value}</span>
                <span class="mt-2 block text-ink-soft">{s.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container-page grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading eyebrow="Notre mission" title="Partnering for a brighter future." />
        <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-soft" data-reveal>
          <p>
            Immigrer au Canada, c’est un projet de vie. C’est aussi des formulaires IRCC, des preuves de fonds, des scores de langue,
            des délais et beaucoup d’incertitude. Notre rôle : transformer ce parcours en étapes claires.
          </p>
          <p>
            Notre équipe connaît les exigences d’IRCC et les programmes provinciaux. Elle construit avec vous un dossier solide, et
            vous prépare en français grâce à nos sessions TCF · TEF à Douala.
          </p>
          <p>
            Vous nous trouvez au bureau à {contact.district}, sur WhatsApp, et sur une ligne au Canada : {contact.phoneCanada}.
          </p>
        </div>
      </div>
      <div class="relative" data-reveal style="--reveal-delay:120ms">
        <Image
          src={family}
          alt="Une famille africaine heureuse se retrouve dans un aéroport canadien enneigé"
          widths={[480, 800, 1100]}
          sizes="(min-width: 1024px) 45vw, 92vw"
          class="aspect-[4/3] w-full rounded-[2rem] object-cover"
        />
        <p class="absolute -bottom-6 left-6 max-w-[16rem] rounded-2xl bg-surface p-5 text-[0.95rem] leading-snug shadow-xl">
          <span class="display block text-2xl text-red">100+</span>
          familles, étudiants et professionnels déjà partis.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container-page">
      <SectionHeading eyebrow="Nos valeurs" title="Ce qui guide chaque dossier." align="center" />
      <div class="mt-14 grid gap-4 sm:grid-cols-2">
        {
          values.map((v, i) => (
            <article class="rounded-[1.75rem] bg-paper p-8" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="flex size-12 items-center justify-center rounded-2xl bg-blue text-white">
                <Icon name={v.icon} class="size-6" />
              </span>
              <h3 class="display mt-6 text-2xl">{v.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-soft">{v.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <FinalCta />
</BaseLayout>
