---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FinalCta from '@/components/FinalCta.astro';
import { images } from '@/data/images';
import { services, whatsappLink } from '@/data/site';

const iconFor: Record<string, string> = {
  house: 'lucide:house',
  'graduation-cap': 'lucide:graduation-cap',
  'briefcase-business': 'lucide:briefcase-business',
  users: 'lucide:users',
  languages: 'lucide:languages',
};
---

<BaseLayout
  title="Nos expertises en immigration Canada"
  description="Résidence permanente, visa étudiant, visa travail, regroupement familial et prépa TCF · TEF : les étapes, les documents et les délais pour chaque projet."
>
  <PageHero
    eyebrow="Nos expertises"
    title="Un seul cabinet pour <span class='text-blue'>tous vos projets</span> Canada."
    lead="Pour chaque projet : à qui il s’adresse, les étapes dans l’ordre, les documents à prévoir et le délai indicatif. Vous savez où vous allez avant de signer."
  >
    <nav aria-label="Aller à une expertise" class="rise mt-10 flex flex-wrap gap-2" style="--d:340ms">
      {
        services.map((s) => (
          <a
            href={`#${s.slug}`}
            class="inline-flex min-h-11 items-center gap-2 rounded-full bg-surface px-4 text-[0.95rem] font-medium text-ink-soft ring-1 ring-line transition-colors hover:text-blue hover:ring-blue/40"
          >
            <Icon name={iconFor[s.icon]} class="size-4 text-blue" />
            {s.label}
          </a>
        ))
      }
    </nav>
  </PageHero>

  <div class="pb-24">
    {
      services.map((s, i) => (
        <section id={s.slug} class="scroll-mt-24 py-14 sm:py-20">
          <div class="container-page grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
            <div class:list={['relative lg:sticky lg:top-28', i % 2 === 1 && 'lg:order-2']} data-reveal>
              <Image
                src={images[s.image]}
                alt={s.imageAlt}
                widths={[480, 800, 1100]}
                sizes="(min-width: 1024px) 45vw, 92vw"
                class="aspect-[4/3] w-full rounded-[2rem] object-cover"
              />
              <p class="absolute bottom-4 left-4 flex items-center gap-2 rounded-full bg-night/85 px-4 py-2 text-sm font-medium text-white backdrop-blur">
                <Icon name="lucide:clock-3" class="size-4 text-sky" />
                {s.timing}
              </p>
            </div>

            <div data-reveal style="--reveal-delay:100ms">
              <p class="eyebrow flex items-center gap-2.5 text-blue">
                <Icon name={iconFor[s.icon]} class="size-4" />
                {s.label}
              </p>
              <h2 class="display mt-4 text-[2rem] sm:text-[2.8rem]">{s.title}</h2>
              <p class="mt-5 text-lg leading-relaxed text-ink-soft">{s.pitch}</p>

              <p class="mt-6 rounded-2xl bg-blue-mist p-5 leading-relaxed">
                <span class="font-semibold">Pour qui ? </span>
                <span class="text-ink-soft">{s.forWho}</span>
              </p>

              <h3 class="mt-9 font-semibold">Programmes couverts</h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {s.programs.map((p) => (
                  <li class="rounded-full bg-surface px-3.5 py-1.5 text-sm font-medium ring-1 ring-line">{p}</li>
                ))}
              </ul>

              <h3 class="mt-9 font-semibold">Les étapes, dans l’ordre</h3>
              <ol class="mt-4 space-y-0">
                {s.steps.map((step, n) => (
                  <li class="relative flex gap-4 pb-5 last:pb-0">
                    {n < s.steps.length - 1 && <span class="absolute top-9 bottom-0 left-[1.05rem] w-px bg-line" aria-hidden="true" />}
                    <span class="flex size-[2.1rem] shrink-0 items-center justify-center rounded-full bg-surface font-mono text-sm font-bold text-blue ring-1 ring-line">
                      {n + 1}
                    </span>
                    <span class="pt-1.5">{step}</span>
                  </li>
                ))}
              </ol>

              <h3 class="mt-9 font-semibold">Documents à prévoir</h3>
              <ul class="mt-3 grid gap-x-6 gap-y-2 sm:grid-cols-2">
                {s.documents.map((doc) => (
                  <li class="flex items-center gap-2.5 text-ink-soft">
                    <Icon name="lucide:file-check-2" class="size-4 shrink-0 text-blue" />
                    {doc}
                  </li>
                ))}
              </ul>

              <div class="mt-10 flex flex-col gap-3 sm:flex-row">
                <a href={`/?programme=${s.slug}#evaluation`} class="btn-primary">
                  Évaluer mon profil
                  <Icon name="lucide:arrow-up-right" class="btn-arrow size-5" />
                </a>
                <a
                  href={whatsappLink(`Bonjour Proxima, je suis intéressé(e) par : ${s.label}. Pouvez-vous m’en dire plus ?`)}
                  target="_blank"
                  rel="noopener"
                  class="btn-ghost"
                >
                  <Icon name="lucide:message-circle" class="size-5 text-[#1f9d55]" />
                  Poser une question
                </a>
              </div>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <FinalCta />
</BaseLayout>
