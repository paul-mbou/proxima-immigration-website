---
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import EvaluationSection from '@/components/EvaluationSection.astro';
import Faq from '@/components/Faq.astro';
import FinalCta from '@/components/FinalCta.astro';
import ProjectSelector from '@/components/react/ProjectSelector';
import Journey from '@/components/react/Journey';
import { images } from '@/data/images';
import { journey, reasons, services, stats, testimonials } from '@/data/site';
import consultant from '@/assets/images/consultant-office.jpg';
import tcfExam from '@/assets/images/tcf-exam.jpg';

const selectorServices = await Promise.all(
  services.map(async (s) => ({
    slug: s.slug,
    label: s.label,
    short: s.short,
    title: s.title,
    icon: s.icon,
    pitch: s.pitch,
    forWho: s.forWho,
    programs: s.programs,
    steps: s.steps,
    timing: s.timing,
    imageAlt: s.imageAlt,
    imageSrc: (await getImage({ src: images[s.image], width: 1000, format: 'webp' })).src,
  })),
);

const initials = (name: string) =>
  name
    .split(/[\s-]+/)
    .map((p) => p[0])
    .join('')
    .slice(0, 2);
---

<BaseLayout
  title="Cabinet d'immigration Canada à Douala · Proxima SARL"
  description="Résidence permanente, visa étudiant, visa travail, regroupement familial et prépa TCF · TEF à Douala. Évaluation gratuite de votre profil, réponse sous 24 h."
>
  <Hero />

  <section aria-label="Proxima en chiffres" class="pb-8">
    <div class="container-page">
      <dl class="grid grid-cols-2 gap-y-8 border-t border-line pt-10 lg:grid-cols-4">
        {
          stats.map((s, i) => (
            <div class="px-2 lg:border-l lg:border-line lg:px-8 lg:first:border-l-0 lg:first:pl-0" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <dt class="sr-only">{s.label}</dt>
              <dd>
                <span class="display block text-4xl text-blue sm:text-5xl">{s.value}</span>
                <span class="mt-2 block text-ink-soft">{s.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" id="projets">
    <div class="container-page">
      <SectionHeading
        eyebrow="Votre projet"
        title="Quel Canada voulez-vous vivre ?"
        lead="Choisissez votre projet : on vous montre pour qui il est fait, les programmes possibles et le délai à prévoir."
      />
      <div class="mt-12" data-reveal>
        <ProjectSelector client:visible services={selectorServices} />
      </div>
    </div>
  </section>

  <section class="section bg-surface" id="parcours">
    <div class="container-page">
      <SectionHeading
        eyebrow="Le trajet Proxima"
        title="De Douala à votre visa, en 5 étapes claires."
        lead="Vous savez toujours où en est votre dossier, et ce qui vient ensuite."
        align="center"
      />
      <div class="mx-auto mt-16 max-w-5xl">
        <Journey client:visible steps={journey} />
      </div>
    </div>
  </section>

  <section class="section" id="pourquoi">
    <div class="container-page grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="relative" data-reveal>
        <Image
          src={consultant}
          alt="Une conseillère explique un dossier à un jeune client attentif"
          widths={[480, 800, 1100]}
          sizes="(min-width: 1024px) 45vw, 92vw"
          class="aspect-[4/3] w-full rounded-[2.25rem] object-cover"
        />
        <div class="absolute right-5 -bottom-6 left-5 rounded-2xl bg-night p-5 text-white shadow-xl sm:right-auto sm:left-8 sm:max-w-xs">
          <p class="display text-3xl">90 %</p>
          <p class="mt-1 text-sm text-white/75">de dossiers acceptés en 2025. Aucun cabinet ne peut garantir un visa : nous maximisons vos chances.</p>
        </div>
      </div>

      <div>
        <SectionHeading eyebrow="Pourquoi Proxima" title="Un cabinet sérieux, des gens joignables." />
        <ul class="mt-10 divide-y divide-line border-t border-line">
          {
            reasons.map((r, i) => (
              <li class="flex gap-5 py-5" data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-blue-mist text-blue">
                  <Icon name={`lucide:${r.icon}`} class="size-5" />
                </span>
                <span>
                  <span class="block text-lg font-semibold">{r.title}</span>
                  <span class="text-ink-soft">{r.text}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="px-3 sm:px-5">
    <div class="relative overflow-hidden rounded-[2.25rem] bg-night text-white">
      <svg class="pointer-events-none absolute -top-20 -left-24 h-[140%] w-auto opacity-[0.12]" viewBox="0 0 400 600" aria-hidden="true">
        <path d="M34 600 L118 600 L372 52 L360 44 Z" fill="#E30713"></path>
      </svg>
      <div class="container-page relative grid items-center gap-12 py-20 sm:py-24 lg:grid-cols-2 lg:gap-16">
        <div data-reveal>
          <p class="eyebrow flex items-center gap-2.5 text-sky"><span class="h-px w-6 bg-red"></span>Prépa TCF · TEF</p>
          <h2 class="display mt-4 text-[2.1rem] sm:text-5xl">Le bon score de français, préparé à Douala.</h2>
          <p class="mt-5 text-lg leading-relaxed text-white/75">
            Le français peut vous rapporter des dizaines de points sur votre profil Entrée express. Nos cours en présentiel
            vous y amènent, compétence par compétence.
          </p>
          <ul class="mt-8 grid grid-cols-2 gap-3 sm:max-w-md">
            {
              [
                ['lucide:calendar-days', '3 mois intensifs'],
                ['lucide:users', '8 élèves maximum'],
                ['lucide:map-pin', 'Présentiel à Deido'],
                ['lucide:file-check-2', 'Examens blancs'],
              ].map(([icon, label]) => (
                <li class="flex items-center gap-3 rounded-2xl bg-white/[0.06] px-4 py-3 text-[0.95rem]">
                  <Icon name={icon} class="size-5 shrink-0 text-sky" />
                  {label}
                </li>
              ))
            }
          </ul>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="/tcf-tef" class="btn-primary">
              Découvrir la formation
              <Icon name="lucide:arrow-up-right" class="btn-arrow size-5" />
            </a>
            <a href="/tcf-tef#convertisseur" class="btn border border-white/25 text-white hover:bg-white/10">
              Convertir mon score en NCLC
            </a>
          </div>
        </div>
        <div class="relative" data-reveal style="--reveal-delay:120ms">
          <Image
            src={tcfExam}
            alt="Des candidats concentrés passent une épreuve écrite de français en salle d'examen"
            widths={[480, 800, 1100]}
            sizes="(min-width: 1024px) 45vw, 92vw"
            class="aspect-[4/3] w-full rounded-[1.75rem] object-cover"
          />
          <div class="absolute -bottom-5 left-5 flex items-center gap-4 rounded-2xl bg-surface px-5 py-4 text-ink shadow-xl sm:-left-6">
            <span class="font-mono text-xs font-semibold tracking-[0.16em] text-ink-mute">OBJECTIF</span>
            <span class="display text-2xl text-blue">NCLC 7+</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="temoignages">
    <div class="container-page">
      <SectionHeading eyebrow="Ils sont partis avec nous" title="Ce que disent nos candidats." />
      <div class="mt-12 grid gap-5 lg:grid-cols-[1.25fr_1fr]">
        <figure class="flex flex-col justify-between rounded-[2rem] bg-blue p-8 text-white sm:p-10" data-reveal>
          <Icon name="lucide:quote" class="size-10 text-white/40" />
          <blockquote class="display mt-6 text-[1.7rem] leading-[1.15] sm:text-[2.1rem]">
            « {testimonials[0].quote} »
          </blockquote>
          <figcaption class="mt-10 flex items-center gap-4">
            <span class="flex size-12 items-center justify-center rounded-full bg-white font-bold text-blue">{initials(testimonials[0].name)}</span>
            <span>
              <span class="block font-semibold">{testimonials[0].name}</span>
              <span class="text-sm text-white/75">{testimonials[0].city} · {testimonials[0].program} · {testimonials[0].year}</span>
            </span>
          </figcaption>
        </figure>
        <div class="grid gap-5">
          {
            testimonials.slice(1).map((t, i) => (
              <figure class="rounded-[2rem] bg-surface p-7 ring-1 ring-line sm:p-8" data-reveal style={`--reveal-delay:${(i + 1) * 110}ms`}>
                <blockquote class="text-lg leading-relaxed">« {t.quote} »</blockquote>
                <figcaption class="mt-6 flex items-center gap-4">
                  <span class="flex size-11 items-center justify-center rounded-full bg-blue-mist font-bold text-blue">{initials(t.name)}</span>
                  <span>
                    <span class="block font-semibold">{t.name}</span>
                    <span class="text-sm text-ink-mute">{t.city} · {t.program} · {t.year}</span>
                  </span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <EvaluationSection />
  <Faq />
  <FinalCta />
</BaseLayout>
