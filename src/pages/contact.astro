---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import EvaluationSection from '@/components/EvaluationSection.astro';
import { contact, whatsappLink } from '@/data/site';

const channels = [
  {
    icon: 'lucide:message-circle',
    label: 'WhatsApp',
    value: contact.whatsapp,
    hint: 'Questions et conseils · réponse sous 24 h',
    href: whatsappLink('Bonjour Proxima, je souhaite parler de mon projet d’immigration au Canada.'),
    external: true,
    featured: true,
  },
  { icon: 'lucide:phone', label: 'Téléphone Cameroun', value: contact.phoneCameroon, hint: 'Appel direct au bureau', href: contact.phoneCameroonHref },
  { icon: 'lucide:phone-call', label: 'Téléphone Canada', value: contact.phoneCanada, hint: 'Ligne canadienne', href: contact.phoneCanadaHref },
  { icon: 'lucide:mail', label: 'E-mail', value: contact.email, hint: 'Pour envoyer vos documents', href: `mailto:${contact.email}` },
];

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(contact.mapQuery)}&output=embed`;
---

<BaseLayout
  title="Contact"
  description="Contactez Proxima SARL à Douala (Deido) : WhatsApp +237 680 225 372, téléphone +237 687 966 812, téléphone Canada +1 (613) 769-8261, e-mail contact@proximaimmigration.com."
>
  <PageHero
    eyebrow="Contact"
    title="Parlons de votre <span class='text-blue'>projet Canada.</span>"
    lead="Choisissez le moyen qui vous arrange. Pour une réponse rapide, WhatsApp reste le plus simple."
  />

  <section class="pb-20">
    <div class="container-page grid gap-6 lg:grid-cols-[1.4fr_0.6fr]">
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          channels.map((c, i) => (
            <li data-reveal style={`--reveal-delay:${i * 70}ms`} class:list={[c.featured && 'sm:col-span-2']}>
              <a
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener' : undefined}
                class:list={[
                  'group flex h-full items-start gap-5 rounded-[1.75rem] p-6 transition-all duration-500 sm:p-7',
                  c.featured
                    ? 'bg-[#1f9d55] text-white hover:bg-[#17803f]'
                    : 'bg-surface ring-1 ring-line hover:shadow-[0_24px_50px_-30px_rgb(10_31_51/0.35)] hover:ring-blue/30',
                ]}
              >
                <span
                  class:list={[
                    'flex size-12 shrink-0 items-center justify-center rounded-2xl',
                    c.featured ? 'bg-white/15' : 'bg-blue-mist text-blue',
                  ]}
                >
                  <Icon name={c.icon} class="size-6" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class:list={['eyebrow block', c.featured ? 'text-white/75' : 'text-ink-mute']}>{c.label}</span>
                  <span
                    class:list={[
                      'mt-1.5 block font-semibold',
                      c.featured ? 'display text-2xl sm:text-3xl' : c.href.startsWith('tel:') ? 'text-lg whitespace-nowrap' : 'text-base [overflow-wrap:anywhere]',
                    ]}
                  >
                    {c.value}
                  </span>
                  <span class:list={['mt-1 block text-sm', c.featured ? 'text-white/80' : 'text-ink-soft']}>{c.hint}</span>
                </span>
                <Icon name="lucide:arrow-up-right" class="size-5 shrink-0 opacity-50 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:opacity-100" />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col overflow-hidden rounded-[1.75rem] bg-surface ring-1 ring-line" data-reveal style="--reveal-delay:200ms">
        <iframe
          title={`Carte : bureau Proxima à ${contact.district}, ${contact.city}`}
          src={mapSrc}
          class="min-h-72 w-full flex-1 border-0 grayscale-[0.3]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
        <div class="flex items-center gap-4 p-6">
          <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-red text-white">
            <Icon name="lucide:map-pin" class="size-6" />
          </span>
          <span>
            <span class="eyebrow block text-ink-mute">Bureau</span>
            <span class="text-lg font-semibold">{contact.district}, {contact.city} · {contact.country}</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <EvaluationSection />
</BaseLayout>
