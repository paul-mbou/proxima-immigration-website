---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, lead, image, imageAlt = '' } = Astro.props;
---

<section class="relative overflow-hidden pt-32 pb-16 sm:pt-40 sm:pb-20">
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(55%_60%_at_90%_10%,var(--color-blue-mist),transparent_70%)]"
    aria-hidden="true"
  >
  </div>
  <div class:list={['container-page grid items-end gap-12', image && 'lg:grid-cols-[1.25fr_1fr]']}>
    <div>
      <p class="eyebrow rise flex items-center gap-2.5 text-blue" style="--d:60ms">
        <span class="size-2 rounded-full bg-red"></span>{eyebrow}
      </p>
      <h1 class="display rise mt-5 text-[2.5rem] sm:text-6xl lg:text-[4.2rem]" style="--d:140ms" set:html={title} />
      <p class="rise mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft sm:text-xl" style="--d:240ms">{lead}</p>
      <slot />
    </div>
    {
      image && (
        <div class="rise relative" style="--d:320ms">
          <div class="absolute -top-4 -right-4 h-2/3 w-2 rounded-full bg-red sm:-right-5" aria-hidden="true" />
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 800, 1100]}
            sizes="(min-width: 1024px) 40vw, 92vw"
            class="aspect-[4/3] w-full rounded-[2rem] object-cover shadow-[0_40px_80px_-40px_rgb(10_31_51/0.5)]"
            loading="eager"
          />
        </div>
      )
    }
  </div>
</section>
